# Rolls Bar staging bootstrap example.
# COPY THIS FILE OUTSIDE GIT and fill locally. Never commit real credentials.

WP_PATH=/absolute/path/to/staging-document-root
PROJECT_ROOT=/absolute/path/to/rollsbar-repository
STAGING_URL=https://staging.example.ru
WP_ADMIN_USER=rollsbar-staging-admin
WP_ADMIN_EMAIL=developer@example.com

DB_NAME=
DB_USER=
DB_HOST=localhost
# DB_PASSWORD is intentionally omitted. bootstrap-staging.sh prompts securely when needed.

WP_LOCALE=ru_RU
WP_TITLE=Rolls Bar — Staging
ROLLSBAR_IMPORT_SMOKE=1
